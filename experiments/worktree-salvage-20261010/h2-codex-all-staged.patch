diff --git a/docs/argus/shadow-feeder/activate-codex.ps1 b/docs/argus/shadow-feeder/activate-codex.ps1
new file mode 100644
index 0000000..e81ed33
--- /dev/null
+++ b/docs/argus/shadow-feeder/activate-codex.ps1
@@ -0,0 +1,35 @@
+param([Parameter(Mandatory)][int]$CurrentProcessId)
+$ErrorActionPreference = 'Stop'
+if (-not $env:ARGUS_TOKEN) { throw 'Load the existing token from your PowerShell profile before activation.' }
+$headers = @{ Authorization = "Bearer $env:ARGUS_TOKEN" }
+$base = 'http://127.0.0.1:7777/api'
+$id = '8a4a1975-0cab-49d8-b9ca-46ca22ed511e'
+$process = Get-CimInstance Win32_Process -Filter "ProcessId = $CurrentProcessId"
+if (-not $process -or $process.CommandLine -notmatch 'server/dist/index.js') { throw 'The specified process is not the expected Argus server.' }
+$before = Invoke-RestMethod "$base/pipelines" -Headers $headers
+$pipeline = $before.pipelines | Where-Object id -eq $id
+if (-not $pipeline) { throw 'Feeder pipeline is missing.' }
+$instances = Invoke-RestMethod "$base/pipelines/$id/instances" -Headers $headers
+if (@($instances.instances | Where-Object status -in @('running', 'awaiting-approval')).Count) { throw 'Wait for active feeder instances before restarting.' }
+$captured = Get-Content (Join-Path $PSScriptRoot 'before-codex-pipeline.json') -Raw | ConvertFrom-Json
+if (($pipeline.phases | ConvertTo-Json -Depth 100 -Compress) -ne ($captured.phases | ConvertTo-Json -Depth 100 -Compress)) { throw 'The feeder definition changed since preparation; inspect it before activation.' }
+$prepared = Get-Content (Join-Path $PSScriptRoot 'pipeline-definition.codex.json') -Raw | ConvertFrom-Json
+if ($pipeline.trigger.kind -ne 'windowed' -or $pipeline.trigger.everyMinutes -ne 12 -or $pipeline.overlapPolicy -ne 'skip' -or @($pipeline.phases | Where-Object timeoutSeconds -ne 240).Count) { throw 'Live cadence or deadline differs from the captured experiment; inspect before activation.' }
+if ($pipeline.runtime -ne 'claude' -or $pipeline.model -ne 'haiku') { throw 'Live feeder differs from the expected Claude rollback configuration.' }
+$beforeH2 = Invoke-RestMethod "$base/decisions/h2" -Headers $headers
+$pipeline | ConvertTo-Json -Depth 100 | Set-Content (Join-Path $PSScriptRoot 'activation-before-pipeline.json')
+$beforeH2 | ConvertTo-Json -Depth 100 | Set-Content (Join-Path $PSScriptRoot 'activation-before-h2.json')
+Stop-Process -Id $CurrentProcessId
+& (Join-Path $PSScriptRoot 'start-collector.ps1') -Runtime codex -Model $prepared.model -ReasoningEffort $prepared.reasoningEffort
+$started = Get-Content (Join-Path $PSScriptRoot 'server-process.json') -Raw | ConvertFrom-Json
+$ready = $null
+for ($attempt = 0; $attempt -lt 20; $attempt++) {
+    try { $ready = Invoke-RestMethod "$base/decisions/h2" -Headers $headers -TimeoutSec 3; break } catch { Start-Sleep -Milliseconds 500 }
+}
+if (-not $ready -or -not $ready.collection.enabled -or $ready.collection.settings.provider -ne 'codex-cli' -or $ready.collection.settings.requestedModel -ne $prepared.model) { throw 'Codex H2 did not become ready. The feeder was not switched; inspect logs, then restore Claude with start-collector.ps1 after stopping the verified new PID.' }
+$current = (Invoke-RestMethod "$base/pipelines" -Headers $headers).pipelines | Where-Object id -eq $id
+if (($current.phases | ConvertTo-Json -Depth 100 -Compress) -ne ($pipeline.phases | ConvertTo-Json -Depth 100 -Compress)) { throw 'Feeder phases changed during activation; inspect before applying the prepared definition.' }
+$patch = @{runtime='codex'; model=$prepared.model; reasoningEffort=$prepared.reasoningEffort; phases=$prepared.phases}
+$updated = Invoke-RestMethod "$base/pipelines/$id" -Method Patch -Headers $headers -ContentType 'application/json' -Body ($patch | ConvertTo-Json -Depth 100)
+@{at=[DateTime]::UtcNow.ToString('o'); pid=$started.pid; h2=$ready.collection; feeder=$updated; scheduledProof='pending'} | ConvertTo-Json -Depth 100 | Set-Content (Join-Path $PSScriptRoot 'activation.json')
+Write-Output 'Codex configuration activated. Scheduled collection verification is still pending.'
