+  for (const blind of [false, true]) {
+    const s = await snap(failedRun({ runtime: "codex", outcome: "blocked" }), lines, blind);
+    const body = s.content.body as Body;
+    assert.equal(body.run.runtime, "codex");
+    assert.ok(body.timeline.events.some((e) => (e.detail ?? e.label).includes("ticket price")));
+    if (blind) assert.equal(body.run.outcome, undefined);
