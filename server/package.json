{
  "name": "@argus/server",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./src/testHome.ts --test \"src/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test:coverage": "tsx --import ./src/testHome.ts --test --experimental-test-coverage --test-coverage-lines=73 --test-coverage-functions=59 --test-coverage-branches=61 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@argus/contracts": "*",
    "@hono/node-server": "^2.0.12",
    "chokidar": "^4.0.3",
    "hono": "^4.12.33",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.5.13",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  }
}
