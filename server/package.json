{
  "name": "@argus/server",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./src/testHome.ts --test --test-reporter=spec --test-reporter-destination=stdout \"src/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test:coverage": "tsx --import ./src/testHome.ts --test --test-reporter=spec --test-reporter-destination=stdout --experimental-test-coverage --test-coverage-lines=73 --test-coverage-functions=59 --test-coverage-branches=61 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@argus/contracts": "*",
    "@hono/node-server": "^2.1.1",
    "chokidar": "^5.0.0",
    "hono": "^4.13.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.5.13",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0"
  }
}
