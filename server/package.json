{
  "name": "@argus/server",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./src/testHome.ts --test --test-reporter=spec --test-reporter-destination=stdout \"src/**/*.test.ts\"",
    "test:timeboxed": "tsx --import ./src/testHome.ts --test --test-timeout=120000 --test-reporter=spec --test-reporter-destination=stdout \"src/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test:coverage": "tsx --import ./src/testHome.ts --test --test-reporter=spec --test-reporter-destination=stdout --experimental-test-coverage --test-coverage-lines=73 --test-coverage-functions=59 --test-coverage-branches=61 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@argus/contracts": "*",
    "@hono/node-server": "^2.1.3",
    "chokidar": "^5.0.0",
    "hono": "^4.13.12",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0"
  }
}
